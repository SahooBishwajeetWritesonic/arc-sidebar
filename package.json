{
  "name": "arc-sidebar",
  "private": true,
  "version": "0.1.0",
  "description": "Arc-style sidebar for Chrome's side panel",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "harness": "vite --config harness/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wxt-dev/module-react": "1.2.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@wxt-dev/storage": "1.3.0",
    "fractional-indexing": "4.0.0",
    "lucide-react": "1.63.0",
    "motion": "14.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  }
}
